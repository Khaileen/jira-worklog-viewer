<Window x:Class="JiraWorklogViewer.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jira Agent Chat"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Options -->
        <GroupBox Grid.Row="0" Header="Options" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="cboModel" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="AWS Profile:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="txtBedrockProfile" Width="90" VerticalAlignment="Center" FontSize="11"
                             ToolTip="AWS SSO profile name for Bedrock (e.g. kmiraato)."
                             LostFocus="TxtBedrockProfile_LostFocus"/>
                </StackPanel>

                <Button Grid.Column="6" x:Name="btnNewChat" Content="🗑 New Chat"
                        Height="28" Click="BtnNewChat_Click"/>
            </Grid>
        </GroupBox>

        <!-- Transcript -->
        <TextBox Grid.Row="1" x:Name="txtTranscript"
                 AcceptsReturn="True" IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"
                 Background="#1E1E1E" Foreground="#D4D4D4"
                 BorderThickness="0" Padding="8"/>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="txtStatus" Margin="0,6,0,6"
                   Text="Type an instruction below, e.g. &quot;Analyze all [Scheduled - no work] assigned to me for Carrier [First Chicago] and see if we can work on it using a single branch and how much can be done in the base.&quot;  (Ctrl+Enter to send)"
                   Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>

        <!-- Input -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="txtInput"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="60" VerticalScrollBarVisibility="Auto"
                     KeyDown="TxtInput_KeyDown"/>
            <Button Grid.Column="2" x:Name="btnSend" Content="▶ Send"
                    Height="30" VerticalAlignment="Bottom" Click="BtnSend_Click"/>
            <Button Grid.Column="4" x:Name="btnCancel" Content="Cancel"
                    Height="30" VerticalAlignment="Bottom" Click="BtnCancel_Click" IsEnabled="False"/>
            <Button Grid.Column="6" Content="Close"
                    Height="30" VerticalAlignment="Bottom" Click="BtnClose_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
