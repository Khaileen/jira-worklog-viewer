<Window x:Class="JiraWorklogViewer.DefenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Time Defense"
        Width="1000" Height="750"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Options -->
        <GroupBox Grid.Row="0" Header="Options" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ticket inputs -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Ticket(s):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ItemsControl x:Name="lstTickets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                    <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110" Margin="0,0,4,0"
                                             CharacterCasing="Upper"/>
                                    <Button Content="✕" Width="22" FontSize="10"
                                            Background="Transparent" BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="BtnRemoveTicket_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="btnAddTicket" Content="+ Add Ticket"
                            Padding="8,3" Margin="6,0,0,0"
                            Click="BtnAddTicket_Click"/>
                </StackPanel>

                <!-- Model + Output format + Actions -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="cboModel" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="Est. Hours:" VerticalAlignment="Center" Margin="0,0,5,0"
                               ToolTip="Original estimate (e.g. 5h, 2h 30m). Leave blank if unknown."/>
                    <TextBox Grid.Column="4" x:Name="txtEstimate" Width="70" VerticalAlignment="Center"
                             ToolTip="Original estimate (e.g. 5h, 2h 30m). Leave blank if unknown."/>


                    <Button Grid.Column="7" x:Name="btnAnalyze" Content="▶ Analyze"
                            Height="30" Click="BtnAnalyze_Click" IsDefault="True"/>
                    <Button Grid.Column="9" x:Name="btnCancel" Content="Cancel"
                            Height="30" Click="BtnCancelAnalyze_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Status + Progress -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="Ready. Add ticket(s) and click Analyze."
                           Foreground="Gray" FontStyle="Italic" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtProgressLabel" Grid.Column="1"
                           Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <ProgressBar Grid.Row="1" x:Name="progressBar"
                         Height="4" Margin="0,4,0,0"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#2563EB" Background="#E5E7EB"
                         Visibility="Collapsed"/>
        </Grid>

        <!-- Output tabs -->
        <TabControl Grid.Row="2" x:Name="tabOutput">
            <TabItem Header="Work Log Summary" x:Name="tabSummary">
                <TextBox x:Name="txtSummary"
                         AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1E1E1E" Foreground="#9CDCFE"
                         BorderThickness="0" Padding="8"/>
            </TabItem>
            <TabItem Header="Analysis" x:Name="tabTechnical">
                <TextBox x:Name="txtTechnical"
                         AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="#1E1E1E" Foreground="#D4D4D4"
                         BorderThickness="0" Padding="8"/>
            </TabItem>
            <TabItem Header="Time Analysis" x:Name="tabTimeAnalysis">
                <TextBox x:Name="txtTimeAnalysis"
                         AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="#1E1E1E" Foreground="#FFD700"
                         BorderThickness="0" Padding="8"/>
            </TabItem>
        </TabControl>

        <!-- Metrics -->
        <TextBlock Grid.Row="3" x:Name="txtMetrics"
                   Foreground="Gray" FontSize="11" Margin="0,6,0,6"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCopySummary" Content="📋 Copy WLS + Prompt"
                    Width="160" Height="30" Margin="0,0,10,0"
                    Click="BtnCopySummary_Click" IsEnabled="False"/>
            <Button x:Name="btnSaveMd" Content="💾 Save as MD"
                    Width="110" Height="30" Margin="0,0,10,0"
                    Click="BtnSaveMd_Click" IsEnabled="False"/>
            <Button Content="Close" Width="80" Height="30"
                    Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
