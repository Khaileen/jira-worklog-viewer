<Window x:Class="JiraWorklogViewer.StandupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Stand-Up Generator"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Controls -->
        <GroupBox Grid.Row="0" Header="Options" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Yesterday:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" x:Name="dpYesterday" Width="130" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="Today:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="4" x:Name="dpToday" Width="130" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="7" x:Name="cboModel" MinWidth="150" MaxWidth="250"
                          VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Button Grid.Column="8" x:Name="btnGenerate" Content="▶ Generate Stand-Up"
                        Height="30" Click="BtnGenerate_Click" IsDefault="True"/>
                <Button Grid.Column="10" x:Name="btnCancel" Content="Cancel"
                        Height="30" Click="BtnCancelGenerate_Click" IsEnabled="False"/>
            </Grid>
        </GroupBox>

        <!-- Status + Progress Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus"
                           Text="Ready. Select dates and click Generate."
                           Foreground="Gray" FontStyle="Italic"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtProgressLabel" Grid.Column="1"
                           Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <ProgressBar Grid.Row="1" x:Name="progressBar"
                         Height="4" Margin="0,4,0,0"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#2563EB" Background="#E5E7EB"
                         Visibility="Collapsed"/>
        </Grid>

        <!-- Output -->
        <GroupBox Grid.Row="2" Header="Stand-Up Summary" Padding="8">
            <TextBox x:Name="txtOutput"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     BorderThickness="0"
                     Padding="8"/>
        </GroupBox>

        <!-- Metrics -->
        <TextBlock Grid.Row="3" x:Name="txtMetrics"
                   Foreground="Gray" FontSize="11"
                   Margin="0,6,0,6"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCopy" Content="📋 Copy to Clipboard"
                    Width="150" Height="30" Margin="0,0,10,0"
                    Click="BtnCopy_Click" IsEnabled="False"/>
            <Button x:Name="btnSaveMd" Content="💾 Save as MD"
                    Width="120" Height="30" Margin="0,0,10,0"
                    Click="BtnSaveMd_Click" IsEnabled="False"/>
            <Button Content="Close" Width="80" Height="30"
                    Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
